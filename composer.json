{
  "name": "womanlab/cpanel-storefront",
  "description": "Aplicación de comercio electrónico Woman Lab para cPanel con PHP y TUU.",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "WomanLab\\": "womanlab-core/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WomanLab\\Tests\\": "womanlab-core/tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml"
  },
  "config": {
    "sort-packages": true
  }
}